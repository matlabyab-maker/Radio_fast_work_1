<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#FFFFFF">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Fast Radio" android:textSize="24sp" android:textStyle="bold" android:textColor="#222222" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Stopped" android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="10dp" />
    <EditText android:id="@+id/streamUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Stream URL (http/https)" android:inputType="textUri" android:singleLine="true" />
    <EditText android:id="@+id/stationName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Station name" android:singleLine="true" />
    <Spinner android:id="@+id/stationIcon" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:contentDescription="Choose radio icon" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
        <Button android:id="@+id/addButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Add" />
        <Button android:id="@+id/playButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Play" />
        <Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Stop" />
    </LinearLayout>
    <ListView android:id="@+id/stationList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="10dp" />
</LinearLayout>
